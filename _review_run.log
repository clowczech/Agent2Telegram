    59	def markdown_to_html(text: str) -> str:
    60	    """Convert the common Markdown subset (``**bold**``, ``*italic*``/``_italic_``,
    61	    `` `code` ``, fenced ``` blocks) to the HTML Telegram supports. Without this, agents'
    62	    Markdown shows literally (asterisks/backticks) in Telegram."""
    63	    stash: list[str] = []
    64	
    65	    def keep(s: str) -> str:
    66	        stash.append(s)
    67	        return f"\x00{len(stash) - 1}\x00"
    68	
    69	    text = re.sub(r"```(?:\w+)?\n?(.*?)```",
    70	                  lambda m: keep(f"<pre>{_html.escape(m.group(1))}</pre>"), text, flags=re.S)
    71	    text = re.sub(r"`([^`\n]+)`",
    72	                  lambda m: keep(f"<code>{_html.escape(m.group(1))}</code>"), text)
    73	    # Markdown links [text](url) → <a href>; stashed so the URL isn't escaped/mangled.
    74	    text = re.sub(
    75	        r"\[([^\]\n]+)\]\((https?://[^\s)]+)\)",
    76	        lambda m: keep(f'<a href="{_html.escape(m.group(2), quote=True)}">{_html.escape(m.group(1))}</a>'),
    77	        text)
    78	    text = _html.escape(text)
    79	    text = re.sub(r"\*\*(.+?)\*\*", r"<b>\1</b>", text, flags=re.S)
    80	    text = re.sub(r"(?<!\w)\*([^*\n]+?)\*(?!\w)", r"<i>\1</i>", text)
    81	    text = re.sub(r"(?<!\w)_([^_\n]+?)_(?!\w)", r"<i>\1</i>", text)
    82	    for i, s in enumerate(stash):
    83	        text = text.replace(f"\x00{i}\x00", s)
    84	    return text
