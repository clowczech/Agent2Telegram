    67	def _extract_tui_tools(pane: str) -> list:
    68	    """Pull live tool/web-search lines out of a Codex TUI capture, as bubble summaries."""
    69	    out = []
    70	    for raw in pane.splitlines():
    71	        s = raw.strip()
    72	        m = _re.search(r"Searched the web for\s+(.+)", s)
    73	        if m:
    74	            out.append("🔎 Web search: " + _short(m.group(1)))
    75	            continue
    76	        if "Searching the web" in s:
    77	            out.append("🔎 Searching the web")
    78	            continue
    79	        # Codex prints the call on a bullet line ("● Ran df -h /", "● Read foo.py") and its
    80	        # output nested under "└ …". Strip any leading bullet/branch markers so we catch the
    81	        # verb on either line; the verb whitelist keeps plain agent text (other words) out.
    82	        body = s.lstrip("└├│•●▪▸·*- \t")
    83	        if not body:
    84	            continue
    85	        verb = body.split(" ", 1)[0]
    86	        if verb in _TUI_VERBS:
    87	            rest = body[len(verb):].strip()
    88	            out.append(f"{_TUI_VERBS[verb]} {verb} {_short(rest)}".rstrip())
    89	    return out
