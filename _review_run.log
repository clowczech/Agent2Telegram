    93	        while not self._stop.is_set():
    94	            try:
    95	                return self.tg.get_me()
    96	            except Exception as e:
    97	                log.warning("Telegram not reachable yet (%s); retrying in %ss", e, delay)
    98	                self._stop.wait(delay)
    99	                delay = min(delay * 2, 60)
   100	        return {}
