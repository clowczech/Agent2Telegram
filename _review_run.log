    26	               content_type: str = "audio/ogg") -> tuple[str, bytes]:
    27	    boundary = "----a2t" + uuid.uuid4().hex
    28	    parts: list[bytes] = []
    29	    for name, value in fields.items():
    30	        parts.append(
    31	            f'--{boundary}\r\nContent-Disposition: form-data; name="{name}"\r\n\r\n{value}\r\n'.encode()
    32	        )
    33	    parts.append(
    34	        f'--{boundary}\r\nContent-Disposition: form-data; name="file"; filename="{filename}"\r\n'
    35	        f'Content-Type: {content_type}\r\n\r\n'.encode()
    36	    )
    37	    parts.append(audio)
    38	    parts.append(f'\r\n--{boundary}--\r\n'.encode())
    39	    return boundary, b"".join(parts)
    40	
    41	
    42	def transcribe_elevenlabs(audio: bytes, *, api_key: str, filename: str = "voice.ogg",
    43	                          opener=None, timeout: float = 120) -> str:
    44	    """Transcribe *audio* bytes with ElevenLabs Scribe. Returns the recognized text."""
    45	    if not api_key:
    46	        raise STTError("no ElevenLabs API key configured")
    47	    boundary, body = _multipart({"model_id": MODEL_ID}, filename, audio)
    48	    req = urllib.request.Request(
    49	        ELEVENLABS_URL,
    50	        data=body,
    51	        headers={
    52	            "xi-api-key": api_key,
    53	            "Content-Type": f"multipart/form-data; boundary={boundary}",
    54	            "Accept": "application/json",
    55	        },
    56	        method="POST",
    57	    )
    58	    op = opener or urllib.request.build_opener()
    59	    try:
    60	        with op.open(req, timeout=timeout) as resp:
    61	            payload = json.loads(resp.read().decode("utf-8"))
    62	    except Exception as e:
    63	        raise STTError(f"ElevenLabs request failed: {e}") from e
    64	    text = (payload.get("text") or "").strip()
    65	    if not text:
    66	        raise STTError("transcription returned no text")
    67	    return text
    68	
    69	
    70	def transcribe(audio: bytes, *, api_key: str, filename: str = "voice.ogg") -> str:
    71	    """Provider dispatcher (only ElevenLabs Scribe today)."""
    72	    return transcribe_elevenlabs(audio, api_key=api_key, filename=filename)

