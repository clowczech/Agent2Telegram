   159	            p = Path(tp).expanduser()
   160	            if p.is_dir():
   161	                return p
   162	        return Path.home() / ".codex" / "sessions"
   163	
   164	    @staticmethod
   165	    def _newest_under(base: Path, *patterns: str) -> Path | None:
   166	        files: list[str] = []
   167	        for pat in (patterns or ("*.jsonl",)):
   168	            files = glob.glob(str(base / "**" / pat), recursive=True)
   169	            if files:
   170	                break
   171	        if not files:
   172	            return None
   173	        try:
   174	            return Path(max(files, key=lambda f: Path(f).stat().st_mtime))
   175	        except OSError:
   176	            return None
   177	
   178	    def _session_cwd(self) -> str | None:
   179	        """Working directory of the driven tmux session — used to pick the matching Codex
   180	        rollout even when other `codex` processes (e.g. cron jobs) write newer rollouts."""
   181	        try:
   182	            out = subprocess.run(
   183	                ["tmux", "display-message", "-p", "-t", self.cfg.tmux_session, "#{pane_current_path}"],
   184	                capture_output=True, text=True, timeout=5)
   185	            return out.stdout.strip() or None
   186	        except (subprocess.SubprocessError, OSError):
   187	            return None
   188	
   189	    @staticmethod
   190	    def _rollout_cwd(path: Path) -> str | None:
   191	        try:
   192	            with open(path, "r", encoding="utf-8", errors="ignore") as f:
   193	                rec = json.loads(f.readline() or "{}")
   194	            return (rec.get("payload") or {}).get("cwd")
   195	        except (OSError, json.JSONDecodeError, ValueError):
   196	            return None
   197	
   198	    @staticmethod
   199	    def _norm(p: str | None) -> str:
   200	        """Normalize a path for comparison — resolves symlinks like /tmp → /private/tmp (macOS)."""
   201	        if not p:
   202	            return ""
   203	        try:
   204	            return str(Path(p).resolve())
   205	        except (OSError, RuntimeError):
   206	            return p
   207	
   208	    def _cwd_matches(self, rollout: Path) -> bool:
   209	        sc = self._session_cwd()
   210	        return bool(sc) and self._norm(self._rollout_cwd(rollout)) == self._norm(sc)
   211	
   212	    def _newest_rollout(self) -> Path | None:
   213	        base = self._codex_sessions_dir()
   214	        files = (glob.glob(str(base / "**" / "rollout-*.jsonl"), recursive=True)
   215	                 or glob.glob(str(base / "**" / "*.jsonl"), recursive=True))
   216	        if not files:
   217	            return None
   218	        try:
   219	            files.sort(key=lambda f: Path(f).stat().st_mtime, reverse=True)
   220	        except OSError:
   221	            return None
   222	        cwd = self._norm(self._session_cwd())
   223	        if cwd:
   224	            for f in files:                       # newest first → our session's own rollout
   225	                if self._norm(self._rollout_cwd(Path(f))) == cwd:
   226	                    return Path(f)
   227	            return None                           # cwd known but no rollout yet → wait, don't grab
   228	        return Path(files[0])                     # cwd unknown → best-effort newest overall
   229	
   230	    def _resolve_transcript(self) -> Path | None:
   231	        """Resolve the transcript to tail. An explicit path is used as-is; ``""``/``"auto"``
   232	        auto-detects the newest transcript for the agent (Codex rollout / Claude Code session)."""
   233	        tp = (self.cfg.transcript_path or "").strip()
   234	        if tp and tp.lower() != "auto":
   235	            p = Path(tp).expanduser()
   236	            return self._newest_under(p) if p.is_dir() else p
   237	        if self.cfg.agent == "codex":
   238	            return self._newest_rollout()
   239	        if self.cfg.agent == "claude-code":
   240	            return self._newest_claude()
   241	        return None
   242	
   243	    def _newest_claude(self) -> Path | None:
   244	        """Newest Claude Code transcript for the driven session, scoped by cwd so it never picks
   245	        up another concurrent Claude session (Claude stores transcripts under a per-cwd project
   246	        dir: ``~/.claude/projects/<cwd-with-slashes-as-dashes>/``)."""
   247	        base = Path.home() / ".claude" / "projects"
   248	        cwd = self._session_cwd()
   249	        dirs: list[Path] = []
   250	        if cwd:
   251	            for c in {cwd, self._norm(cwd)}:
   252	                d = base / c.replace("/", "-")
   253	                if d.is_dir():
   254	                    dirs.append(d)
   255	        if not dirs:
   256	            return self._newest_under(base) if not cwd else None
   257	        best, best_m = None, -1.0
   258	        for d in dirs:
   259	            p = self._newest_under(d, "*.jsonl")
   260	            try:
   261	                if p and p.stat().st_mtime > best_m:
   262	                    best, best_m = p, p.stat().st_mtime
   263	            except OSError:
   264	                pass
   265	        return best
   266	
   267	    def _maybe_reresolve(self) -> None:
   268	        """Keep the tailed transcript pointed at our tmux session's own log (auto mode only).
   269	
   270	        Agents write the transcript on the first message (not at launch), and a session restart
   271	        starts a new one — so we re-check periodically. We switch when a better match appears, but
   272	        never abandon a transcript we're already on for an in-flight turn. A no-op when the config
   273	        gives an explicit transcript path (the path resolves to itself)."""
   274	        if (self.cfg.transcript_path or "").strip().lower() not in ("", "auto"):
   275	            return                                # explicit path → nothing to re-resolve
   276	        now = time.monotonic()
   277	        if now - self._last_resolve < 3.0:
   278	            return
   279	        self._last_resolve = now
   280	        newest = self._resolve_transcript()
   281	        if not newest or newest == self._transcript:
   282	            return
   283	        # cwd-scoped resolution returns OUR session's own log, so follow it even mid-turn: a new
   284	        # rollout for the same session means the current turn is being written THERE. Blocking the
   285	        # switch while a turn was active caused a ~90s lag (it only switched after the idle timeout)
   286	        # — the first message looked like it took ~2 minutes. Only the cwd-unknown best-effort
   287	        # fallback still avoids jumping away during a live turn.
   288	        if self._session_cwd() is None and self._transcript is not None and self._turn_active.is_set():
   289	            return
   290	        log.info("transcript → %s", newest.name)
   291	        self._transcript = newest
   292	        self._tpos = 0
   293	        self._resume_position()
   294	
   295	    # ---- lifecycle ---------------------------------------------------------
   296	    def run(self) -> None:
   297	        me = self.tg.get_me()
   298	        log.info("Attach bridge live as @%s → tmux '%s', owner=%s",
   299	                 me.get("username"), self.cfg.tmux_session, self._owner_chat)
   300	        self.tg.set_my_commands(BOT_COMMANDS)    # enable the "/" command menu in Telegram
   301	        if not self._session.alive:
   302	            raise RuntimeError(f"tmux session '{self.cfg.tmux_session}' not found")
   303	        # Start tailing at EOF. If we've run before (the ledger has entries), rewind to the start
   304	        # of the current turn so a reply written while we were restarting still gets forwarded —
   305	        # the ledger dedups, so nothing already delivered is re-sent. On the very first run we do
   306	        # NOT rewind, so attaching to an already-busy session never re-posts its prior turn.
   307	        if self._transcript and self._transcript.exists():
   308	            self._tpos = self._transcript.stat().st_size
   309	            if self._sent_keys:
   310	                self._resume_position()
   311	        self._cleanup_orphan_status()       # remove a bubble orphaned by a prior crash/restart
   312	        # Typing runs in its own thread so a flood-control sleep in the send path never starves it.
   313	        threading.Thread(target=self._outbound_loop, daemon=True).start()
   314	        threading.Thread(target=self._typing_loop, daemon=True).start()
   315	        if self.cfg.agent == "codex":
   316	            # Codex logs tools to the rollout only at completion → scrape the TUI for LIVE bubbles.
   317	            threading.Thread(target=self._tui_scrape_loop, daemon=True).start()
   318	        self._inbound_loop()
   319	
   320	    def _resume_position(self) -> None:
   321	        """Find the most recent non-empty user message and rewind ``_tpos`` to just after it,
   322	        so the current turn's assistant messages are re-read on startup. Combined with the
   323	        persisted ledger this re-delivers a reply that was written while we were down, without
   324	        re-sending anything already delivered. Also recovers the turn's Telegram origin."""
   325	        size = self._tpos
   326	        start = max(0, size - 5_000_000)        # large window: tool outputs can be big
   327	        try:
   328	            with open(self._transcript, "rb") as f:
   329	                f.seek(start)
   330	                tail = f.read()
   331	        except OSError:
   332	            return
   333	        pos = start
   334	        last_user_end = None
   335	        from_tg = self._turn_from_tg
   336	        for raw in tail.split(b"\n"):
   337	            line_end = pos + len(raw) + 1       # +1 for the newline separator
   338	            pos = line_end
   339	            try:
   340	                rec = json.loads(raw.decode("utf-8", "ignore"))
   341	            except (json.JSONDecodeError, ValueError):
   342	                continue
   343	            utext = self._reader.user_text(rec)
   344	            if utext and utext.strip():
   345	                from_tg = utext.lstrip().startswith(self._origins)
   346	                last_user_end = min(line_end, size)
   347	        if last_user_end is not None:
   348	            self._tpos = last_user_end
   349	            self._turn_from_tg = from_tg
   350	
   351	    def _mark_sent(self, uuid: str) -> None:
   352	        """Record a forwarded message uuid in memory and on disk (append-only ledger)."""
   353	        if not uuid or uuid in self._sent_keys:
   354	            return
   355	        self._sent_keys.add(uuid)
   356	        try:
   357	            self._sent_path.parent.mkdir(parents=True, exist_ok=True)
   358	            with open(self._sent_path, "a", encoding="utf-8") as f:
   359	                f.write(uuid + "\n")
   360	        except OSError:
   361	            pass
   362	
   363	    # ---- durable outbound delivery (never drop a reply) --------------------
   364	    def _load_queue(self) -> list:
   365	        if self._queue_path is None or not self._queue_path.exists():
   366	            return []
   367	        out = []
   368	        try:
   369	            for line in self._queue_path.read_text("utf-8").splitlines():
   370	                line = line.strip()
   371	                if line:
   372	                    out.append(json.loads(line))
   373	        except (OSError, ValueError):
   374	            return []
   375	        return out
   376	
   377	    def _persist_queue(self) -> None:
   378	        if self._queue_path is None:
   379	            return
   380	        try:
   381	            self._queue_path.parent.mkdir(parents=True, exist_ok=True)
   382	            tmp = self._queue_path.parent / (self._queue_path.name + ".tmp")
   383	            with open(tmp, "w", encoding="utf-8") as f:
   384	                for item in self._pending_send:
   385	                    f.write(json.dumps(item, ensure_ascii=False) + "\n")
   386	            tmp.replace(self._queue_path)          # atomic, no os import needed
   387	        except OSError:
   388	            pass
   389	
   390	    def _enqueue(self, text: str, key: str | None) -> None:
   391	        self._pending_send.append({"text": text, "key": key})
   392	        self._persist_queue()
   393	
   394	    def _send_final(self, text: str, key: str | None = None) -> None:
   395	        """Forward one reply RELIABLY. Marks the dedup ledger only AFTER a confirmed send; on any
   396	        send failure the reply is queued to disk and the outbound loop keeps retrying until Telegram
   397	        confirms. Order is preserved: if anything is already queued, this appends behind it."""
   398	        if not text or self._owner_chat is None:
   399	            return
   400	        if key and key in self._sent_keys:
   401	            return
   402	        if self._pending_send:                       # something already waiting → keep FIFO order
   403	            self._enqueue(text, key)
   404	            return
   405	        try:
   406	            self.tg.send_message(self._owner_chat, text)
   407	        except Exception as e:                        # network reset, 5xx after retries, etc.
   408	            log.warning("forward failed → queued for re-delivery: %s", e)
   409	            self._enqueue(text, key)
   410	            return
   411	        if key:
   412	            self._mark_sent(key)
   413	        self._turn_text_sent = True
   414	        log.info("FWD (send) %r", text[:30])
   415	
   416	    def _flush_pending(self) -> None:
   417	        """Re-send queued replies FIFO until one fails (then stop, preserving order for next pass).
   418	        Called every outbound cycle, so a transient network failure self-heals within ~0.4 s."""
   419	        while self._pending_send and self._owner_chat is not None:
   420	            item = self._pending_send[0]
   421	            try:
   422	                self.tg.send_message(self._owner_chat, item.get("text", ""))
   423	            except Exception as e:
   424	                log.warning("re-delivery still failing (%d queued): %s", len(self._pending_send), e)
   425	                return
   426	            self._pending_send.pop(0)
   427	            self._persist_queue()
   428	            if item.get("key"):
   429	                self._mark_sent(item["key"])
   430	            self._turn_text_sent = True
   431	            log.info("FWD (re-delivered) %r", str(item.get("text", ""))[:30])
   432	
   433	    # ---- inbound (Telegram → session) -------------------------------------
   434	    def _inbound_loop(self) -> None:
   435	        offset = 0
   436	        allowed_updates = json.dumps(["message", "edited_message", "message_reaction"])
   437	        while not self._stop.is_set():
   438	            try:
   439	                updates = self.tg._call(
   440	                    "getUpdates",
   441	                    {"offset": offset, "timeout": self.cfg.poll_timeout,
   442	                     "allowed_updates": allowed_updates},
   443	                    timeout=self.cfg.poll_timeout + 15,
   444	                )
   445	            except Exception as e:
   446	                log.error("getUpdates failed: %s", e)
   447	                self._stop.wait(3)
   448	                continue
   449	            for upd in updates:
   450	                offset = max(offset, upd["update_id"] + 1)
   451	                try:
   452	                    self._handle(upd)
   453	                except Exception as e:
   454	                    log.exception("inbound error: %s", e)
   455	
   456	    def _handle(self, upd: dict) -> None:
   457	        # Reactions (e.g. ❤️) → quick-feedback line.
   458	        mr = upd.get("message_reaction")
   459	        if mr:
   460	            if mr.get("user", {}).get("id") not in self._allowed:
   461	                return
   462	            emojis = "".join(r.get("emoji", "") for r in mr.get("new_reaction", [])
   463	                             if r.get("type") == "emoji")
   464	            if emojis:
   465	                self._inject(f"{emojis} reacted {emojis} to your message #{mr.get('message_id')} "
   466	                             f"— quick feedback; no need to reply unless relevant.")
   467	            return
   468	
   469	        msg = upd.get("message") or upd.get("edited_message")
   470	        if not msg:
   471	            return
   472	        user_id = msg.get("from", {}).get("id")
   473	        chat_id = msg["chat"]["id"]
   474	        if user_id not in self._allowed:
   475	            self.tg.send_message(chat_id, "⛔ Not authorized.")
   476	            return
   477	
   478	        # Bridge-level slash commands (e.g. /start, /help) are answered here instead of being
   479	        # forwarded to the agent — so the first contact is a friendly intro, not the agent
   480	        # puzzling over "/start". Only plain-text commands, never media captions.
   481	        text0 = (msg.get("text") or "").strip()
   482	        if text0.startswith("/") and not (msg.get("voice") or msg.get("audio")
   483	                                           or msg.get("photo") or msg.get("document")):
   484	            if self._handle_command(text0, chat_id, msg.get("message_id")):
   485	                return
   486	
   487	        # Light "typing…" from the very first moment — including the voice-transcription /
   488	        # file-download window (seconds), so the indicator never has a gap at the start.
   489	        self._consume_turn_end()                 # drop any stale end-marker from a prior turn
   490	        now = time.monotonic()
   491	        self._turn_active.set()
   492	        self._last_activity = now
   493	        self._turn_started = now
   494	        self._typing_count = 1
   495	        self._max_gap = 0.0
   496	        self._last_typing = now
   497	        self._turn_text_sent = False             # gate TUI bubbles until intro text lands
   498	        # Seed the TUI dedup with tool lines ALREADY on screen from previous turns, so the
   499	        # scraper only emits calls that appear DURING this turn — otherwise stale lines still
   500	        # visible in the pane get re-sent as bubbles under the new turn.
   501	        if self.cfg.agent == "codex":
   502	            try:
   503	                self._tui_seen = set(_extract_tui_tools(self._session._capture()))
   504	            except Exception:
   505	                self._tui_seen = set()
   506	        else:
   507	            self._tui_seen = set()
   508	        self.tg.send_chat_action(self._owner_chat, "typing")   # instant, don't wait for the loop
   509	        log.info("TURN START t=%.2f", time.time())
   510	
   511	        text = (msg.get("text") or msg.get("caption") or "").strip()
   512	        if msg.get("voice") or msg.get("audio"):
   513	            text = self._transcribe(msg.get("voice") or msg.get("audio"), chat_id) or text
   514	            if not text:
   515	                return
   516	        elif msg.get("photo") or msg.get("document"):
   517	            note = self._download_note(msg, chat_id)
   518	            text = f"{text}\n{note}".strip() if note else text
   519	        if text:
   520	            self._inject(text)
   521	
   522	    def _inject(self, text: str) -> None:
   523	        self._turn_active.set()
   524	        self._last_activity = time.monotonic()   # keep typing lit from the very start
   525	        try:
   526	            self._session.inject(text)
   527	        except Exception as e:
   528	            log.error("inject failed: %s", e)
   529	            self._turn_active.clear()
   530	
   531	    def _handle_command(self, text: str, chat_id: int, message_id: int | None = None) -> bool:
   532	        """Answer a bridge-level slash command. Returns True if handled (don't forward to agent)."""
   533	        parts = text.split(maxsplit=1)
   534	        cmd = parts[0].lstrip("/").split("@")[0].lower()
   535	        arg = parts[1].strip() if len(parts) > 1 else ""
   536	        labels = {"codex": "Codex", "claude-code": "Claude Code"}
   537	        agent = labels.get(self.cfg.agent, self.cfg.agent)
   538	        if cmd in ("start", "help"):
   539	            voice = "on" if self.cfg.elevenlabs_api_key else "off — enable with /setkey"
   540	            self.tg.send_message(chat_id,
   541	                f"👋 You're connected to a live *{agent}* session via Agent2Telegram.\n\n"
   542	                "Just send a message — it goes straight to the agent and you'll see typing, live "
   543	                "progress, what tools it runs, and the reply. You can also send *photos* and "
   544	                "*files*, and react with ❤️ as quick feedback.\n\n"
   545	                f"🎤 Voice transcription: {voice}.\n\n"
   546	                "Commands: /help · /status · /id · /setkey")
   547	            return True
   548	        if cmd == "id":
   549	            self.tg.send_message(chat_id, f"Your Telegram id: `{chat_id}`")
   550	            return True
   551	        if cmd == "status":
   552	            voice = "✓" if self.cfg.elevenlabs_api_key else "✗"
   553	            self.tg.send_message(chat_id,
   554	                f"✅ Connected — *{agent}* in tmux session `{self.cfg.tmux_session}`.\n"
   555	                f"🎤 Voice (ElevenLabs): {voice}")
   556	            return True
   557	        if cmd == "setkey":
   558	            return self._set_voice_key(arg, chat_id, message_id)
   559	        return False    # unknown command → let the agent handle it
   560	
   561	    def _set_voice_key(self, key: str, chat_id: int, message_id: int | None) -> bool:
   562	        """Save an ElevenLabs key to enable voice, then delete the message so the secret isn't
   563	        left in the chat history."""
   564	        if not key:
   565	            self.tg.send_message(chat_id,
   566	                "Usage: `/setkey <your ElevenLabs API key>` — enables voice-message transcription.\n"
   567	                "I'll delete your message right after so the key isn't left in the chat.")
   568	            return True
   569	        self.cfg.elevenlabs_api_key = key
   570	        try:
   571	            from .config import save
   572	            save(self.cfg)                       # persisted 0600 to the active config path
   573	        except Exception as e:
   574	            log.error("setkey: could not persist config: %s", e)
   575	        if message_id is not None:
   576	            self.tg.delete_message(chat_id, message_id)   # don't leave the secret in history
   577	        self.tg.send_message(chat_id,
   578	            "✅ Voice transcription enabled — key saved. I deleted your message so the key "
   579	            "isn't left in the chat history. Send a voice note to try it.")
   580	        return True
   581	
   582	    def _typing_loop(self) -> None:
   583	        """Dedicated thread: assert "typing…" every TYPING_INTERVAL while a turn is active.
   584	
   585	        It runs independently of the outbound/send loop, so a flood-control sleep in the send path
   586	        (which happens during a burst of messages) can never starve the indicator — that was the
   587	        cause of mid-turn typing gaps. It stops the instant the turn ends (turn_active cleared), so
   588	        no action fires after the final message and typing stops with it (bar Telegram's ~5s decay)."""
   589	        while not self._stop.is_set():
   590	            if self._turn_active.is_set() and self._owner_chat is not None:
   591	                now = time.monotonic()
   592	                gap = now - self._last_typing
   593	                if gap > self._max_gap:
   594	                    self._max_gap = gap
   595	                self.tg.send_chat_action(self._owner_chat, "typing")
   596	                self._last_typing = now
   597	                self._typing_count += 1
   598	            self._stop.wait(TYPING_INTERVAL)
   599	
   600	    def _tui_scrape_loop(self) -> None:
   601	        """Codex only: scrape the tmux pane for live tool/web-search lines → status bubbles, so
   602	        Codex (whose rollout logs tools only at completion) shows them live like Claude Code."""
   603	        while not self._stop.is_set():
   604	            if self._turn_active.is_set() and self._turn_from_tg and self._owner_chat is not None:
   605	                # Hold bubbles until the intro text is forwarded (so the bubble doesn't jump ahead
   606	                # of "I'll search the web…"), then release; after a short grace show them anyway.
   607	                ready = self._turn_text_sent or \
   608	                    (time.monotonic() - self._turn_started) >= TUI_BUBBLE_GRACE
   609	                if ready:
   610	                    try:
   611	                        for summary in _extract_tui_tools(self._session._capture()):
   612	                            if summary not in self._tui_seen:
   613	                                self._tui_seen.add(summary)
   614	                                self._status_push(summary)
   615	                    except Exception as e:
   616	                        log.debug("tui scrape: %s", e)
   617	            self._stop.wait(1.0)
   618	
   619	    def _consume_turn_end(self) -> None:
   620	        if self._turn_end is not None:
   621	            try:
   622	                self._turn_end.unlink()
   623	            except OSError:
   624	                pass
