    40	        from .config import config_path
    41	        d = Path(config_path()).parent
    42	    except Exception:
    43	        return []
    44	    out = []
    45	    if d.is_dir():
    46	        for p in sorted(d.glob("*.json")):
    47	            try:
    48	                out.append(json.loads(p.read_text("utf-8")))
    49	            except Exception:
    50	                pass
    51	    return out
    52	
    53	
    54	def _mark(signal: str) -> None:
    55	    marker = Path(signal).parent / "turn_end"
