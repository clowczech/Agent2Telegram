   124	def _codex_tool_summary(payload: dict) -> str:
   125	    pt = payload.get("type")
   126	    if pt == "function_call":
   127	        name = payload.get("name", "")
   128	        try:
   129	            args = json.loads(payload.get("arguments") or "{}")
   130	        except Exception:
   131	            args = {}
   132	        if name in ("exec_command", "shell", "local_shell", "container.exec"):
   133	            cmd = args.get("cmd") or args.get("command") or ""
   134	            if isinstance(cmd, list):
   135	                cmd = " ".join(str(c) for c in cmd)
   136	            return "🛠️ " + _short(cmd or name)
   137	        if name in ("read_file", "view"):
   138	            return "📄 Reading " + _short(os.path.basename(args.get("path", "")) or "file")
   139	        if name.startswith("mcp"):
   140	            return "🔌 " + _short(name)
   141	        return "🛠️ " + _short(name or "tool")
   142	    if pt == "custom_tool_call":
   143	        name = payload.get("name", "tool")
   144	        if name == "apply_patch":
   145	            return "✏️ " + _short("apply_patch")
   146	        return "🛠️ " + _short(name)
   147	    if pt == "web_search_call":
   148	        action = payload.get("action") if isinstance(payload.get("action"), dict) else {}
   149	        q = action.get("query") or (action.get("queries") or [""])[0] or ""
   150	        return "🔎 Web search: " + _short(q) if q else "🔎 Searching the web"
   151	    return "🛠️ tool"
