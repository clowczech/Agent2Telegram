    30	def prefer_ipv4() -> None:
    31	    """Prefer IPv4 for outbound connections (idempotent, process-wide).
    32	
    33	    Some hosts have a broken/slow IPv6 route to Telegram — the connect hangs ~20s while IPv4 is
    34	    instant — and Python's default resolver order tries IPv6 first, so every API call stalls.
    35	    (curl avoids it via Happy Eyeballs; urllib doesn't.) We filter resolver results to IPv4 when
    36	    any exist, falling back to the full list on IPv6-only hosts."""
    37	    global _ipv4_patched
    38	    if _ipv4_patched:
    39	        return
    40	    _orig = socket.getaddrinfo
    41	
    42	    def _gai(host, port, family=0, *args, **kwargs):
    43	        res = _orig(host, port, family, *args, **kwargs)
    44	        v4 = [r for r in res if r[0] == socket.AF_INET]
    45	        return v4 or res
    46	
    47	    socket.getaddrinfo = _gai
    48	    _ipv4_patched = True
