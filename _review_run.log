   120	    def _dispatch(self, update: dict) -> None:
   121	        msg = update.get("message")
   122	        if not msg:
   123	            return
   124	        chat_id = msg["chat"]["id"]
   125	        user = msg.get("from", {})
   126	        user_id = user.get("id")
   127	        text = (msg.get("text") or msg.get("caption") or "").strip()
