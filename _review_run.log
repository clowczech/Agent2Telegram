   322	class _ChatWorker(threading.Thread):
   323	    """Serializes processing for a single chat."""
   324	
   325	    def __init__(self, chat_id: int, bridge: Bridge) -> None:
   326	        super().__init__(daemon=True, name=f"chat-{chat_id}")
   327	        self.chat_id = chat_id
   328	        self.bridge = bridge
   329	        self.q: queue.Queue = queue.Queue()
   330	
   331	    def submit(self, task) -> None:
   332	        self.q.put(task)
   333	
   334	    def stop(self) -> None:
   335	        self.q.put(None)
   336	
   337	    def run(self) -> None:
   338	        while True:
   339	            task = self.q.get()
   340	            if task is None:
   341	                return
   342	            try:
   343	                self.bridge.process(self.chat_id, task)
   344	            except Exception as e:  # belt and braces: a worker must never die silently
   345	                log.exception("worker %s crashed handling a message: %s", self.chat_id, e)

