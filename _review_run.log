   137	                f"Your user id is `{user_id}` — ask the owner to add it.",
   138	                parse_mode="Markdown",
   139	            )
   140	            return
   141	
   142	        task = self._build_task(chat_id, msg, text)
   143	        if task is not None:
   144	            self._enqueue(chat_id, task)
