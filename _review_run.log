    33	_SEP_RE = re.compile(r"^[\s─━—–_=·.\-]{6,}$")
    34	_STATUS_RE = re.compile(r"^[✻✶✳✢✺✷*]\s")           # spinner/status, e.g. "✻ Worked for 1s"
    35	_BULLET_RE = re.compile(r"^\s*[⏺●○•]\s?")           # assistant output bullet
