   121	    def __init__(self, token: str, *, max_retries: int = 5, opener=None) -> None:
   122	        if not token or ":" not in token:
   123	            raise TelegramError("Invalid bot token.")
   124	        prefer_ipv4()                       # dodge slow/broken IPv6 routes to Telegram
   125	        self._token = token
   126	        self._max_retries = max_retries
   127	        # `opener` is injectable so tests can run without touching the network.
   128	        self._opener = opener or urllib.request.build_opener()
   129	
   130	    # ---- low-level ---------------------------------------------------------
   131	    def _call(self, method: str, params: dict | None = None, *, timeout: float = 65,
   132	              retries: int | None = None) -> dict:
   133	        url = f"{API_ROOT}/bot{self._token}/{method}"
   134	        data = urllib.parse.urlencode(params or {}, doseq=True).encode()
   135	        mx = self._max_retries if retries is None else retries
   136	        attempt = 0
   137	        while True:
   138	            attempt += 1
   139	            try:
   140	                req = urllib.request.Request(url, data=data, method="POST")
   141	                with self._opener.open(req, timeout=timeout) as resp:
   142	                    body = json.loads(resp.read().decode("utf-8"))
   143	                if not body.get("ok"):
   144	                    raise TelegramError(f"{method}: {body.get('description', 'unknown error')}")
   145	                return body["result"]
   146	            except urllib.error.HTTPError as e:
   147	                retry_after = self._retry_after(e)
   148	                if retry_after is not None:
   149	                    log.warning("Flood control on %s, waiting %ss", method, retry_after)
   150	                    time.sleep(retry_after + 0.5)
   151	                    continue                         # do not count flood waits as failures
   152	                if e.code >= 500 and attempt <= mx:
   153	                    log.warning("%s: HTTP %s, retry %d/%d (backoff)", method, e.code, attempt, mx)
   154	                    self._backoff(attempt)
   155	                    continue
   156	                raise TelegramError(f"{method}: HTTP {e.code} {e.reason}") from e
   157	            except (urllib.error.URLError, TimeoutError, ConnectionError, json.JSONDecodeError) as e:
   158	                if attempt <= mx:
   159	                    log.warning("%s: %s, retry %d/%d (backoff)", method, e, attempt, mx)
   160	                    self._backoff(attempt)
   161	                    continue
   162	                raise TelegramError(f"{method}: {e}") from e
   163	
   164	    @staticmethod
   165	    def _retry_after(err: urllib.error.HTTPError) -> int | None:
   166	        if err.code != 429:
   167	            return None
   168	        try:
   169	            payload = json.loads(err.read().decode("utf-8"))
   170	            return int(payload.get("parameters", {}).get("retry_after", 1))
   171	        except Exception:
   172	            return int(err.headers.get("Retry-After", 1) or 1)
   173	
   174	    @staticmethod
   175	    def _backoff(attempt: int) -> None:
   176	        time.sleep(min(2 ** attempt, 30))
