     1	"""Claude Code **Stop hook** for Agent2Telegram (attach mode).
     2	
     3	Claude Code has no end-of-turn record in its transcript, so to switch the "typing…" indicator
     4	off and clear the live status bubble at the *exact* moment a turn ends, the bridge relies on a
     5	tiny marker file. Claude Code runs this hook at the end of every assistant turn; it writes that
     6	marker for the matching session. (Codex needs no hook — its rollout log records ``task_complete``.)
     7	
     8	The bridge forwards every assistant message by tailing the transcript directly, so this hook does
     9	**not** send anything itself — it only signals "turn ended".
    10	
    11	Register it once (the setup wizard does this) in the agent's settings, e.g. ``~/.claude/settings.json``::
    12	
    13	    {"hooks": {"Stop": [{"hooks": [{"type": "command",
    14	       "command": "python3 -m agent2telegram.stop_hook"}]}]}}
    15	
    16	It reads the signal path / optional session guard from the Agent2Telegram config, so the command
    17	line needs no arguments. Always exits 0 (never blocks the agent).
    18	"""
    19	from __future__ import annotations
    20	
    21	import json
    22	import os
    23	import sys
    24	import time
    25	from pathlib import Path
    26	
    27	
    28	def _load_cfg() -> dict:
    29	    try:
    30	        from .config import config_path
    31	        return json.loads(Path(config_path()).read_text("utf-8"))
    32	    except Exception:
    33	        return {}
    34	
    35	
    36	def _all_cfgs() -> list[dict]:
    37	    """Every bridge config in the config directory — so a single global Stop hook serves multiple
    38	    Claude bridges (each `agent2telegram connect` writes its own <name>.json)."""
