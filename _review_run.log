    85	class ClaudeCodeReader:
    86	    """Claude Code transcript (one JSONL record per message; assistant records carry text and
    87	    tool_use blocks; user records may be real messages or tool results). No turn boundaries in
    88	    the file — the bridge handles those via the Stop-hook marker and idle fallback."""
    89	
    90	    name = "claude-code"
    91	    emits_turn_end = False
    92	
    93	    def user_text(self, rec: dict) -> str | None:
    94	        if rec.get("type") != "user":
    95	            return None
    96	        return _text_of(rec.get("message", {}).get("content"))
    97	
    98	    def parse(self, rec: dict):
    99	        typ = rec.get("type")
   100	        if typ == "user":
   101	            t = _text_of(rec.get("message", {}).get("content"))
   102	            if t.strip():
   103	                yield Ev("user", text=t)
   104	            return
   105	        if typ != "assistant":
   106	            return
   107	        blocks = rec.get("message", {}).get("content")
   108	        blocks = blocks if isinstance(blocks, list) else []
   109	        # Text first, then tool calls — so a progress message clears the previous bubble before
   110	        # the next call re-creates it below (the bridge relies on this order).
   111	        text = "\n".join(b.get("text", "") for b in blocks
   112	                         if isinstance(b, dict) and b.get("type") == "text").strip()
   113	        if text:
   114	            yield Ev("text", text=text, key=rec.get("uuid", "") or _hash(text))
   115	        for b in blocks:
   116	            if isinstance(b, dict) and b.get("type") == "tool_use":
   117	                tid = b.get("id")
   118	                if tid:
   119	                    yield Ev("tool", text=_claude_tool_summary(b.get("name", ""), b.get("input")), key=tid)
