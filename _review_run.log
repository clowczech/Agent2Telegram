    91	def split_message(text: str, limit: int = MAX_MESSAGE_LEN) -> list[str]:
    92	    """Split *text* into Telegram-sized chunks, preferring paragraph then line then
    93	    word boundaries, and hard-splitting only as a last resort. Pure function — tested."""
    94	    text = text or ""
    95	    if len(text) <= limit:
    96	        return [text] if text else []
    97	    chunks: list[str] = []
    98	    remaining = text
    99	    while len(remaining) > limit:
   100	        window = remaining[:limit]
   101	        # Prefer the latest natural boundary inside the window.
   102	        for sep in ("\n\n", "\n", " "):
   103	            cut = window.rfind(sep)
   104	            if cut > limit * 0.5:        # only if it doesn't waste too much of the window
   105	                break
   106	        else:
   107	            cut = limit                  # no good boundary: hard cut
   108	        cut = cut if cut > 0 else limit
   109	        chunks.append(remaining[:cut].rstrip("\n"))
   110	        remaining = remaining[cut:].lstrip("\n")
   111	    if remaining:
   112	        chunks.append(remaining)
   113	    return [c for c in chunks if c]
