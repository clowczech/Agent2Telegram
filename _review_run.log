   154	class CodexReader:
   155	    """Codex CLI rollout transcript (``~/.codex/sessions/.../rollout-*.jsonl``). Each line is an
   156	    ``event_msg`` or ``response_item`` with a ``payload.type``. Crucially it records explicit
   157	    ``task_started`` / ``task_complete`` events, so turn boundaries (and thus the typing
   158	    indicator and bubble cleanup) need no external Stop hook."""
   159	
   160	    name = "codex"
   161	    emits_turn_end = True
   162	
   163	    def user_text(self, rec: dict) -> str | None:
   164	        p = rec.get("payload") if isinstance(rec.get("payload"), dict) else {}
   165	        if rec.get("type") == "event_msg" and p.get("type") == "user_message":
   166	            return p.get("message", "")
   167	        return None
   168	
   169	    def parse(self, rec: dict):
   170	        t = rec.get("type")
   171	        p = rec.get("payload") if isinstance(rec.get("payload"), dict) else {}
   172	        pt = p.get("type")
   173	        if t == "event_msg" and pt == "task_started":
   174	            yield Ev("turn_start")
   175	        elif t == "event_msg" and pt == "user_message":
   176	            msg = p.get("message", "")
   177	            if msg.strip():
   178	                yield Ev("user", text=msg)
   179	        elif t == "event_msg" and pt == "agent_message":
   180	            msg = (p.get("message") or "").strip()
   181	            if msg:
   182	                ts = rec.get("timestamp", "")
   183	                yield Ev("text", text=msg, key=f"{ts}:{_hash(msg)}",
   184	                         final=(p.get("phase") == "final_answer"))
   185	        elif t == "response_item" and pt in ("function_call", "custom_tool_call", "web_search_call"):
   186	            if pt == "web_search_call":
   187	                action = p.get("action") if isinstance(p.get("action"), dict) else {}
   188	                key = "web:" + (action.get("query") or "search")     # stable across status updates
   189	            else:
   190	                key = p.get("call_id") or _hash(json.dumps(p, sort_keys=True)[:200])
   191	            yield Ev("tool", text=_codex_tool_summary(p), key=key)
   192	        elif t == "event_msg" and pt == "task_complete":
   193	            yield Ev("turn_end")
   194	
   195	
   196	def for_agent(agent: str):
   197	    """Return the reader for the configured agent (defaults to Claude Code)."""
   198	    return CodexReader() if (agent or "").lower() == "codex" else ClaudeCodeReader()

