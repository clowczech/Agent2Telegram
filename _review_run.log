   146	    def _build_task(self, chat_id: int, msg: dict, text: str) -> "Task | None":
   147	        # Image → download the largest size and attach it.
   148	        if msg.get("photo"):
   149	            path = self._download(chat_id, msg["photo"][-1]["file_id"], default_name="image.jpg")
   150	            if not path:
   151	                self.tg.send_message(chat_id, "⚠️ Couldn't download the image.")
   152	                return None
   153	            return Task(text=text, attachment=path)
   154	        # Document / arbitrary file.
   155	        if msg.get("document"):
   156	            doc = msg["document"]
   157	            path = self._download(chat_id, doc["file_id"], default_name=doc.get("file_name") or "file")
   158	            if not path:
   159	                self.tg.send_message(chat_id, "⚠️ Couldn't download the file.")
   160	                return None
   161	            return Task(text=text, attachment=path)
   162	        # Voice / audio → transcribe (only if a key is configured).
   163	        media = msg.get("voice") or msg.get("audio")
