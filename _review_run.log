   102	def save(cfg: Config, path: Path | None = None) -> Path:
   103	    cfg.validate()
   104	    p = path or config_path()
   105	    p.parent.mkdir(parents=True, exist_ok=True)
   106	    # Lock down the directory too (best effort) — it holds a secret-bearing file.
   107	    try:
   108	        os.chmod(p.parent, stat.S_IRWXU)   # 0700
   109	    except OSError:
   110	        pass
   111	    # Write atomically, then lock down permissions — the file contains a secret.
   112	    tmp = p.with_suffix(p.suffix + ".tmp")
   113	    tmp.write_text(json.dumps(asdict(cfg), indent=2, ensure_ascii=False), "utf-8")
   114	    os.chmod(tmp, stat.S_IRUSR | stat.S_IWUSR)   # 0600
   115	    os.replace(tmp, p)
   116	    return p

